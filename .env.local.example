# Local watsonx.data Developer Edition + local CockroachDB
#
# Copy to .env.local (which is .gitignored) and edit:
#   cp .env.local.example .env.local
#
# Then:
#   ./scripts/port-forward-wxd.sh    # Presto:8443 + MinIO:9000
#   source .env.local
#   uv run crdb-wxd-pipeline webhook
#
# The defaults below assume the standard kind-based DE install in namespace "wxd"
# and the chaos demo / single-node CockroachDB on the host at localhost:26257.

# ---------- CockroachDB (local) ----------
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# ---------- CDC pipeline ----------
CDC_MODE=webhook
CDC_BATCH_SIZE=100
CDC_BATCH_TIMEOUT_SECONDS=15

# CRDB requires HTTPS for webhook sinks; pipeline serves with adhoc self-signed cert
CDC_WEBHOOK_HTTPS=true

# ---------- MinIO (S3-compatible storage in DE) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dummyvalue           # default DE credential, change if you customised
S3_SECRET_KEY=dummyvalue           # default DE credential, change if you customised
S3_REGION=us-east-1
S3_BUCKET=iceberg-bucket
S3_PREFIX=cdc/expenses/

# ---------- watsonx.data Developer Edition (Presto) ----------
PRESTO_ENGINE_HOST=localhost
PRESTO_PORT=8443
WATSONX_DATA_USERNAME=ibmlhadmin   # default DE credential
WATSONX_DATA_PASSWORD=password     # default DE credential, change if you customised
WATSONX_DATA_VERIFY_SSL=false      # DE uses a self-signed cert
WATSONX_DATA_CATALOG=iceberg_data
WATSONX_DATA_NAMESPACE=banko

# Make sure cloud creds are NOT set (would override local mode detection)
unset WATSONX_DATA_API_KEY 2>/dev/null || true
unset COS_API_KEY 2>/dev/null || true
