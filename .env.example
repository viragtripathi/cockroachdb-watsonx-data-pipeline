# CockroachDB
COCKROACHDB_VERSION=v25.4.6
DATABASE_URL=cockroachdb://root@localhost:26257/defaultdb?sslmode=disable

# CDC Pipeline
CDC_MODE=webhook
CDC_BATCH_SIZE=100
CDC_BATCH_TIMEOUT_SECONDS=30

# IBM Cloud Object Storage (optional, falls back to local filesystem)
# COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
# COS_API_KEY=your-cos-api-key
# COS_INSTANCE_ID=crn:v1:bluemix:public:cloud-object-storage:global:...
# COS_BUCKET=crdb-lakehouse

# Kafka / Debezium (only needed with --profile kafka)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_CDC_TOPICS=crdb.defaultdb.public.expenses
# KAFKA_GROUP_ID=crdb-wxd-pipeline
# CONFLUENT_VERSION=7.4.0
# DEBEZIUM_VERSION=3.5.0.Final

# watsonx.data / Presto (Iceberg table insert)
# PRESTO_ENGINE_HOST=xxxx.wxd.xxxxx.lakehouse.ibmappdomain.cloud
# WATSONX_DATA_API_KEY=your-ibm-cloud-api-key
# WATSONX_DATA_CATALOG=iceberg_data
# WATSONX_DATA_NAMESPACE=banko

# Grafana (only needed with --profile dashboard)
# No configuration needed -- starts with admin/admin at http://localhost:3000

# Legacy watsonx.data config (for future Iceberg REST catalog integration)
# WATSONX_DATA_URL=https://us-south.lakehouse.cloud.ibm.com
# WATSONX_DATA_INSTANCE_ID=your-instance-id
